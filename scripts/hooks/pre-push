#!/usr/bin/env bash
# Scan the commits being pushed, not the working tree: a fix that is not committed must not let a push through.
set -uo pipefail
zero=0000000000000000000000000000000000000000

if ! git diff-index --quiet HEAD --; then
  echo "PRIVACY: uncommitted changes to tracked files; commit or stash them so the scan matches what is pushed"
  git diff-index --name-only HEAD --
  exit 1
fi

fail=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  bash scripts/privacy-scan.sh "$local_sha" || fail=1
done
exit "$fail"
